    },
    "This operation will perform a cascade delete, removing all albums and songs of the selected artists from the local library.": {
      "comment": "The message displayed in the confirmation dialog for batch deleting artists.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "བཀོལ་སྤྱོད་འདིས་མཉམ་སུབ་བྱེད་ངེས་ཡིན། ས་གནས་དཔེ་མཛོད་ནས་བདམས་པའི་སྒྱུ་རྩལ་པའི་ཆེད་བསྒྲིགས་དང་གླུ་གཞས་ཚང་མ་སུབ་པར་བྱེད།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation will perform a cascade delete, removing all albums and songs of the selected artists from the local library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作によりカスケード削除が実行され、選択したアーティストのすべてのアルバムと曲がローカルライブラリから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将执行级联删除，从本地资料库中移除所选艺术家的所有专辑和歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作將執行級聯刪除，從本地資料庫中移除所選藝人的所有專輯和歌曲。"
          }
        }
      }
    },
    "This operation will perform a cascade delete, removing all albums and songs of this artist from the local library.": {
