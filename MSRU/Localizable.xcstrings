    "Analysis runs only when requested. Missing results play at original gain.": {
      "comment": "A description of how Replay Gain analysis works.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "རེ་ཞུ་བྱས་སྐབས་ཁོ་ནར་དབྱེ་ཞིབ་བྱེད། དབྱེ་ཞིབ་མ་བྱས་པའི་གླུ་གཞས་རང་འགོའི་སྒྲ་ཤུགས་ལྟར་གཏོང་བ།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis runs only when requested. Missing results play at original gain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析は要求された場合にのみ実行されます。結果がない場合は元のゲインで再生されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在请求时运行响度分析。未分析的曲目以原始增益播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在請求時執行音量分析。未分析的曲目以原始增益播放。"
          }
        }
      }
    },
