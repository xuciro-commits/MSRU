    "Interactive diagnostic controls will be added once frontend info architecture is stable." : {
      "extractionState" : "manual",
      "localizations" : {
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "མདུན་སྣེའི་ཆ་འཕྲིན་སྒྲིག་བཀོད་བརྟན་པོ་ཆགས་རྗེས། ཕན་ཚུན་འབྲེལ་བའི་ནད་བརྟག་ཚོད་འཛིན་ལ་སྦྲེལ་རྒྱུ།"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interactive diagnostic controls will be added once frontend info architecture is stable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フロントエンドの情報アーキテクチャが安定した後、インタラクティブな診断コントロールが追加されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前端信息架构稳定后，将接入可交互的诊断控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前端信息架構穩定後，將接入可交互的診斷控制。"
          }
        }
      }
    },
