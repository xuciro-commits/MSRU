    "Import local music, perform fingerprinting, entity resolution, and confidence review.": {
      "extractionState": "manual",
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ས་གནས་ཀྱི་རོལ་དབྱངས་ནང་འཇུག་བྱས་ནས། སྒྲ་རིས་ངོས་འཛིན་དང་། དངོས་པོ་ཟླ་སྒྲིལ། ཡིད་ཆེས་ཚད་ཞིབ་བཤེར་བཅས་བྱ་རྒྱུ།"
          }
