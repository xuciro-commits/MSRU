    "Enable or disable metadata providers. The system will chain-fetch authoritative metadata and HD cover art through active providers.": {
      "extractionState": "manual",
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "གཞི་གྲངས་རྩ་བ་མཁོ་སྤྲོད་པ་སྤྱོད་པའམ་མཚམས་འཇོག་པ། མ་ལག་གིས་དབང་གྲགས་གཞི་གྲངས་རྩ་བ་དང་སྤུས་ལེགས་ཁ་ཤོག་ལེན་རྒྱུ།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable or disable metadata providers. The system will chain-fetch authoritative metadata and HD cover art through active providers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータプロバイダを有効または無効にします。システムは有効なプロバイダを通じて、信頼できるメタデータと高解像度カバーアートを連鎖的に取得します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用或停用元数据提供商。系统将通过已启用的提供商链式获取权威元数据与高清封面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
