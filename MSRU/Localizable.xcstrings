    "Place a .lrc file in the same folder as the audio, and it will be loaded automatically.": {
      "extractionState": "manual",
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྒྲ་ཟིན་ཡིག་ཆ་དང་མཉམ་དུ་ .lrc ཡིག་ཆ་བཞག་ན་རང་འགུལ་གྱིས་ནང་འཇུག་བྱེད་ཐུབ།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a .lrc file in the same folder as the audio, and it will be loaded automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオと同じフォルダに同名の.lrcファイルを置くと、自動的に読み込まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在音频文件同目录下放置同名 .lrc 文件，将自动加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在音訊檔案同目錄下放置同名 .lrc 檔案，將自動載入。"
          }
        }
      }
    },
    "Place a .lrc file with the same name in the audio directory, or try again later.": {
      "extractionState": "manual",
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྒྲ་ཟིན་དང་མཉམ་དུ་མིང་གཅིག་པའི .lrc ཡིག་ཆ་བཞག་ན་འགྲིག ཡང་ན་ཅུང་ཙམ་སོང་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱེད་རོགས།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
