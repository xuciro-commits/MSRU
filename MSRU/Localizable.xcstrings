    "Place a .lrc file in the same folder as the audio, and it will be loaded automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "སྒྲ་ཟིན་ཡིག་ཆ་དང་མཉམ་དུ་ .lrc ཡིག་ཆ་བཞག་ན་རང་འགུལ་གྱིས་ནང་འཇུག་བྱེད་ཐུབ།"
          }
