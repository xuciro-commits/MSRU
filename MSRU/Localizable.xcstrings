    "MSRU automatically monitors these directories in the background. Any new or modified audio files will be incrementally ingested.": {
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "MSRU ཡིས་དཀར་ཆག་འདི་དག་རྒྱབ་སྟེགས་སུ་རང་འགུལ་ལྟ་ཞིབ་བྱེད། གསར་དུ་བསྣན་པའམ་བཟོ་བཅོས་བྱས་པའི་སྒྲ་ཟིན་ཡིག་ཆ་རིམ་སྣོན་ངང་ནང་འཇུག་བྱེད།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MSRU automatically monitors these directories in the background. Any new or modified audio files will be incrementally ingested."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MSRUはこれらのディレクトリをバックグラウンドで自動監視します。新規または変更されたオーディオファイルは増分取り込みされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MSRU 会在后台自动监控这些目录。任何新增或修改的音频文件都会被增量导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MSRU 會在後台自動監控這些目錄。任何新增或修改的音訊檔案都會被增量匯入。"
          }
        }
      }
    },
