    "Boost may clip loud recordings; playback volume stays unchanged.": {
      "comment": "A description of the effect of using the equalizer.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྒྲ་ཤུགས་ཆེར་བསྐྱེད་ཀྱིས་སྒྲ་འཛིན་རྙོག་པ་བཟོ་སྲིད། གཏོང་བའི་སྒྲ་ཚད་མི་འགྱུར།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boost may clip loud recordings; playback volume stays unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブーストにより大音量の録音でクリッピングが発生する可能性があります。再生音量は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强可能导致高电平录音削波失真；播放音量保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強可能導致高電平錄音削波失真；播放音量保持不變。"
          }
        }
      }
    },
