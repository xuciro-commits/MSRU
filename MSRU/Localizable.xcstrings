    },
    "This operation will perform a cascade delete, removing all albums and songs of this artist from the local library." : {
      "extractionState" : "manual",
      "localizations" : {
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "བཀོལ་སྤྱོད་འདིས་སྒྱུ་རྩལ་པ་དེའི་ཆེད་བསྒྲིགས་དང་གླུ་གཞས་ཚང་མ་ས་གནས་དཔེ་མཛོད་ནས་མཉམ་དུ་སུབ་རྒྱུ།"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This operation will perform a cascade delete, removing all albums and songs of this artist from the local library."
          }
