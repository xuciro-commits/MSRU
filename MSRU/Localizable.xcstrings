    "The songs leave the Library. Files stay on disk.": {
      "comment": "Confirmation dialog message for removing songs from the library.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "གླུ་གཞས་དཔེ་མཛོད་ནས་སུབ་ཀྱང་ཡིག་ཆ་སྡུད་སྡེར་ཐོག་ཏུ་སོར་གནས་བྱེད།"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The songs leave the Library. Files stay on disk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲はライブラリから削除されますが、ファイルはディスクに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲将从资料库中移除，文件仍保留在磁盘上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲將從資料庫中移除，檔案仍保留在硬碟上。"
          }
        }
      }
    },
    "The songs leave the Library. Their files stay on disk.": {
