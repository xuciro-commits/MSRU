      "localizations": {
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "བཀོལ་སྤྱོད་འདིས་སྒྱུ་རྩལ་པ་དེའི་ཆེད་བསྒྲིགས་དང་གླུ་གཞས་ཚང་མ་ས་གནས་དཔེ་མཛོད་ནས་མཉམ་དུ་སུབ་རྒྱུ། བཀོལ་སྤྱོད་འདི་ཕྱིར་འཐེན་བྱེད་མི་ཐུབ།"
          }
